# Frontend (Vite) environment.
# Copy to .env.local and customise.

# When 'true', the app talks to the real backend.
# When unset/false, the app runs against the mock seed in src/data/seed.ts.
VITE_USE_API=false

# Backend base URL (only used when VITE_USE_API=true)
VITE_API_URL=http://localhost:4000/api/v1
