// Trinamix Portfolio Command Center — Prisma schema (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Location {
  id                  String     @id @default(cuid()) @map("_id")
  name                String
  region              String
  type                String
  timezone            String?
  resources           Resource[]
  contactName         String?
  contactTitle        String?
  contactEmail        String?
  trinamixOwner       String?
  aiStage             String?
  dealRating          Int?       @default(0)
  copyOracle          Boolean?   @default(false)
  emailOwner          String?
  interestedScenarios String[]
  followUpNotes       String?
  urgentNotes         String?
  lastReviewed        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Resource {
  id                  String               @id @default(cuid()) @map("_id")
  name                String
  initials            String
  email               String               @unique
  role                String
  level               String
  active              Boolean              @default(true)
  weeklyCapacityHours Int                  @default(40)
  timeOffHours        Int                  @default(0)
  skills              String[]
  costRate            Float?
  startDate           DateTime?
  endDate             DateTime?
  managerId           String?
  manager             Resource?            @relation("ResourceManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports             Resource[]           @relation("ResourceManager")
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id])
  allocations         ResourceAllocation[]
  ownedProducts       Product[]            @relation("ProductOwner")
  ownedProjects       Project[]            @relation("ProjectOwner")
  ownedOpportunities  Opportunity[]        @relation("OpportunityOwner")
  ownedRisks          Risk[]               @relation("RiskOwner")
  assignedTasks       Task[]               @relation("TaskAssignee")
  decisions           Decision[]           @relation("DecisionMaker")
  customFieldValues   CustomFieldValue[]   @relation("ResourceCustomValue")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Client {
  id            String        @id @default(cuid()) @map("_id")
  name          String
  industry      String
  region        String
  logoColor     String?
  status        String        @default("active")
  contractType  String?
  msrp          Float?
  notes         String?
  opportunities Opportunity[]
  projects      Project[]
  meetings      Meeting[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Product {
  id                 String                @id @default(cuid()) @map("_id")
  name               String
  shortName          String
  strategicBucket    String
  vision             String
  problem            String
  targetUsers        String
  pricingModel       String?
  architectureStatus String
  maturity           String
  aiReadiness        Int                   @default(0)
  deliveryReadiness  Int                   @default(0)
  ownerId            String
  owner              Resource              @relation("ProductOwner", fields: [ownerId], references: [id])
  capabilities       CapabilityOnProduct[]
  opportunities      Opportunity[]
  projects           Project[]
  roadmapItems       RoadmapItem[]
  risks              Risk[]
  tags               String[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Opportunity {
  id                    String   @id @default(cuid()) @map("_id")
  name                  String
  description           String
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id])
  productId             String?
  product               Product? @relation(fields: [productId], references: [id])
  ownerId               String
  owner                 Resource @relation("OpportunityOwner", fields: [ownerId], references: [id])
  value                 Float
  probability           Int
  stage                 String
  source                String?
  strategicImportance   String
  expectedCloseDate     DateTime
  lastInteractionAt     DateTime
  nextSteps             String?
  requiredCapabilityIds String[]
  contactName           String?
  contactTitle          String?
  contactEmail          String?
  trinamixOwner         String?
  dealRating            Int?     @default(0)
  copyOracle            Boolean? @default(false)
  emailOwner            String?
  interestedScenarios   String[]
  followUpNotes         String?
  urgentNotes           String?
  lastReviewed          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Project {
  id           String               @id @default(cuid()) @map("_id")
  name         String
  code         String               @unique
  type         String
  charter      String
  scope        String
  status       String
  rag          String
  weeklyStatus String?
  startDate    DateTime
  endDate      DateTime
  budget       Float?
  spent        Float?
  clientId     String
  client       Client               @relation(fields: [clientId], references: [id])
  productId    String?
  product      Product?             @relation(fields: [productId], references: [id])
  ownerId      String
  owner        Resource             @relation("ProjectOwner", fields: [ownerId], references: [id])
  resourceIds  String[]
  milestones   Milestone[]
  workstreams  Workstream[]
  tasks        Task[]
  risks        Risk[]
  issues       Issue[]
  decisions    Decision[]
  allocations  ResourceAllocation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Milestone {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String?
  dueDate     DateTime
  status      String
  ownerId     String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
}

model Workstream {
  id          String  @id @default(cuid()) @map("_id")
  name        String
  description String?
  status      String
  ownerId     String
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  tasks       Task[]
}

model Task {
  id                 String      @id @default(cuid()) @map("_id")
  title              String
  description        String?
  status             String
  priority           String
  dueDate            DateTime?
  assigneeId         String?
  assignee           Resource?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  projectId          String?
  project            Project?    @relation(fields: [projectId], references: [id])
  workstreamId       String?
  workstream         Workstream? @relation(fields: [workstreamId], references: [id])
  parentId           String?
  parent             Task?       @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           Task[]      @relation("TaskHierarchy")
  aiSourced          Boolean     @default(false)
  sourceTranscriptId String?
  effortHours        Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model ActionItem {
  id                 String    @id @default(cuid()) @map("_id")
  title              String
  status             String    @default("open")
  dueDate            DateTime?
  assigneeId         String?
  meetingId          String?
  projectId          String?
  productId          String?
  opportunityId      String?
  source             String    @default("manual")
  confidence         String?
  reviewed           Boolean   @default(false)
  sourceTranscriptId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ResourceAllocation {
  id            String   @id @default(cuid()) @map("_id")
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id])
  productId     String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  opportunityId String?
  role          String
  hoursPerWeek  Float
  startDate     DateTime
  endDate       DateTime
  confidence    String   @default("committed")
}

model Risk {
  id           String   @id @default(cuid()) @map("_id")
  title        String
  description  String
  severity     String
  likelihood   Float
  impact       Int
  status       String
  mitigation   String?
  ownerId      String
  owner        Resource @relation("RiskOwner", fields: [ownerId], references: [id])
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  identifiedAt DateTime @default(now())
}

model Issue {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String
  severity    String
  status      String
  resolution  String?
  ownerId     String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  raisedAt    DateTime @default(now())
}

model Decision {
  id            String   @id @default(cuid()) @map("_id")
  title         String
  context       String
  decision      String
  rationale     String?
  status        String
  alternatives  String[]
  decidedAt     DateTime @default(now())
  decidedBy     String
  decider       Resource @relation("DecisionMaker", fields: [decidedBy], references: [id])
  productId     String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  opportunityId String?
}

model OpenQuestion {
  id         String    @id @default(cuid()) @map("_id")
  question   String
  context    String?
  status     String
  answer     String?
  askedAt    DateTime  @default(now())
  answeredAt DateTime?
}

model Dependency {
  id          String @id @default(cuid()) @map("_id")
  fromId      String
  fromType    String
  toId        String
  toType      String
  kind        String
  criticality String
  notes       String?
}

model Meeting {
  id          String       @id @default(cuid()) @map("_id")
  title       String
  scheduledAt DateTime
  durationMin Int          @default(60)
  attendeeIds String[]
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  agenda      String?
  notes       String?
  transcripts Transcript[]
}

model Transcript {
  id            String         @id @default(cuid()) @map("_id")
  title         String
  source        String
  uploadedAt    DateTime       @default(now())
  uploadedBy    String
  status        String
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id])
  rawText       String
  extractionJob ExtractionJob?
  createdAt     DateTime       @default(now())
}

model ExtractionJob {
  id           String     @id @default(cuid()) @map("_id")
  transcriptId String     @unique
  transcript   Transcript @relation(fields: [transcriptId], references: [id])
  provider     String
  status       String
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  resultJson   Json?
  errorMessage String?
}

model RoadmapItem {
  id          String  @id @default(cuid()) @map("_id")
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String
  description String?
  quarter     String
  status      String
  ownerId     String?
}

model Capability {
  id             String                @id @default(cuid()) @map("_id")
  name           String                @unique
  description    String
  maturity       String
  reusePotential Int                   @default(0)
  dependsOn      String[]
  products       CapabilityOnProduct[]
  accelerators   Accelerator[]
}

model CapabilityOnProduct {
  id           String     @id @default(cuid()) @map("_id")
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])

  @@unique([productId, capabilityId])
}

model Accelerator {
  id           String     @id @default(cuid()) @map("_id")
  name         String
  description  String
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])
  status       String
  url          String?
}

model AIUseCase {
  id            String  @id @default(cuid()) @map("_id")
  name          String
  description   String
  category      String
  productId     String?
  expectedValue Float?
  status        String
}

model LeadershipUpdate {
  id            String    @id @default(cuid()) @map("_id")
  weekOf        DateTime
  summary       String
  highlights    String[]
  lowlights     String[]
  asks          String[]
  generatedById String?
  generatedAt   DateTime  @default(now())
  publishedAt   DateTime?
}

model CustomField {
  id         String             @id @default(cuid()) @map("_id")
  objectType String
  name       String
  type       String
  options    Json?
  required   Boolean            @default(false)
  helpText   String?
  values     CustomFieldValue[]
  createdAt  DateTime           @default(now())

  @@unique([objectType, name])
}

model CustomFieldValue {
  id         String      @id @default(cuid()) @map("_id")
  fieldId    String
  field      CustomField @relation(fields: [fieldId], references: [id])
  objectType String
  objectId   String
  value      Json
  resource   Resource?   @relation("ResourceCustomValue", fields: [objectId], references: [id])
  updatedAt  DateTime    @updatedAt
}

model SavedView {
  id          String   @id @default(cuid()) @map("_id")
  ownerId     String
  name        String
  objectType  String
  layout      String
  filtersJson Json
  sortJson    Json?
  columns     String[]
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid()) @map("_id")
  actorId    String?
  objectType String
  objectId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  occurredAt DateTime @default(now())
  userName   String?
  userEmail  String?
  ipAddress  String?
  userAgent  String?
}

model User {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("viewer")
  resourceId   String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
