# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://trinamix:trinamix@localhost:5432/portfolio?schema=public

# AI extraction provider — mock | anthropic | openai | gemini | oci
LLM_PROVIDER=mock

# Provider credentials (only set what you use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OCI_REGION=
OCI_COMPARTMENT_OCID=

# Optional auth (placeholder for future)
JWT_SECRET=dev-secret-rotate-me

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h

# Redis (for BullMQ async extraction queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI providers
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
